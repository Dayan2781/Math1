<docinfo>

  <!-- Custom math macros -->
  <macros>
    \newcommand{\R}{\mathbb{R}}
    \newcommand{\N}{\mathbb{N}}
    \newcommand{\Z}{\mathbb{Z}}
    \newcommand{\Q}{\mathbb{Q}}
    \newcommand{\C}{\mathbb{C}}
  </macros>

 <latex-preamble>
  \usepackage{pgfplots}
  \pgfplotsset{compat=1.18}
  \pgfplotsset{xdiscontinuity/.style={axis x discontinuity=parallel}}
  \pgfplotsset{ydiscontinuity/.style={axis y discontinuity=crunch}}
  \pgfplotsset{hollowdot/.style={color=blue,fill=white,only marks,mark size=2.4pt,mark=*}}
  \pgfplotsset{soliddot/.style={color=blue,only marks,mark size=2.4pt,mark=*}}
  \pgfplotsset{infinite/.style={{Kite}-{Kite}}}
  \pgfplotsset{infiniteleft/.style={{Kite}-}}
  \pgfplotsset{infiniteright/.style={-{Kite}}}
  \pgfplotsset{infiniteopen/.style={shorten &gt;=-2.4pt,{Kite}-{Circle[open]}}}
  \pgfplotsset{openinfinite/.style={shorten &lt;=-2.4pt,{Circle[open]}-{Kite}}}
  \usetikzlibrary{arrows.meta}
  \usepackage{tikz}
</latex-preamble>
  <!-- Brand logo / institutional identity (optional) -->
  <brandlogo url="https://num.edu.mn" source="logo.png" />

  <!-- Theme color (Active Calculus uses a friendly green/gold palette) -->
