    <!-- ═══════════════════════════════════════════════════════════
         БҮЛЭГ 2: Үндсэн функцүүд  (2 лекц + 3 семинар)

         Файлуудыг нэгтгэх:
           part1 = §2.1–2.5  (тэгш/сондгой, монотон, зааглагдсан,
                               олон гишүүнт, рационал, тригонометр)
           part2 = §2.6–2.10 (урвуу триг, илтгэгч/лог,
                               дараалал, AP, GP)
           sem23 = Семинар 2 + ГД 2 + Семинар 3 + ГД 3
                   (§2.1–2.4 болон §2.5–2.7 хамрах)
           part2 дахь Семинар 4 + ГД 4 = §2.8–2.10 хамрах

         Хэрэглэх заавар (Mac дээр нэг удаа ажиллуулна):
           cd ~/Desktop/math1/source/chapters
           python3 - <<'EOF'
           p1 = open('ch-basic-functions-part1.ptx').read()
           p2 = open('ch-basic-functions-part2.ptx').read()
           s  = open('ch-basic-functions-sem23.ptx').read()
           # part1-ийн </chapter> өмнө sem23 + part2 оруулна
           merged = p1.replace('</chapter>',
                        s + '\n' + p2 + '\n</chapter>')
           open('ch-basic-functions.ptx','w').write(merged)
           print('OK')
           EOF
         ═══════════════════════════════════════════════════════════ -->
