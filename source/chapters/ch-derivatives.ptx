        iframe="ai-practice.html?topics=параметр функцийн уламжлал,далд функцийн уламжлал,дээд эрэмбийн уламжлал,дифференциал,шүргэгч нормал шулуун&amp;label=Лекц 7-ийн сэдвүүд"
        width="100%" aspect="4:3" />
    </section>
  </section>

  <!-- ════════════════════════════════════════════════════════════
       ЛЕКЦ 8
       §4.10 Дифференциал тооллын үндсэн теоремүүд
       §4.11 Өсөлт, бууралт, монотон шинжилгээ
       ════════════════════════════════════════════════════════════ -->

  <!-- ============================================================
       §4.10 Дифференциал тооллын үндсэн теоремүүд
       ============================================================ -->
  <section xml:id="sec-mvt">
    <title>Дифференциал тооллын үндсэн теоремүүд</title>

    <theorem xml:id="thm-fermat">
      <title>Фермагийн теорем</title>
      <statement>
        <p><m>f</m> функц <m>x = a</m> дээр локал экстремумтай бөгөөд
        <m>f'(a)</m> оршин байвал <m>f'(a) = 0</m>.</p>
      </statement>
      <proof>
        <p><m>a</m> локал максимум тохиолдолд баталъя. <m>x \gt a</m>
        үед <m>\dfrac{f(x)-f(a)}{x-a} \le 0</m>,
        <m>x \lt a</m> үед <m>\dfrac{f(x)-f(a)}{x-a} \ge 0</m>. Хязгаар
        оршин байхын тулд баруун ба зүүн хязгаарууд тэнцүү байх ёстой.
        Тэгвэл зөвхөн <m>f'(a) = 0</m> боломжтой.</p>
      </proof>
    </theorem>

    <theorem xml:id="thm-rolle">
      <title>Роллын теорем</title>
      <statement>
        <p><m>f</m> нь <m>[a,b]</m> дээр тасралтгүй, <m>(a,b)</m>
        дээр дифференциалчлагдаж, <m>f(a) = f(b)</m> бол
        <m>f'(c) = 0</m> байх <m>c \in (a,b)</m> олдоно.</p>
      </statement>
      <proof>
        <p><m>f</m> тасралтгүй учир <m>[a,b]</m>-д хамгийн их ба
        бага утгаа авна. Хэрэв <m>f</m> тогтмол биш бол экстремум нь
        <m>(a,b)</m>-д дотор оршино. Фермагийн теоремоор тэр цэгт
        <m>f'(c) = 0</m>.</p>
      </proof>
    </theorem>

    <example xml:id="ex-rolle">
      <statement>
        <p><m>f(x) = x^2 - 4x + 3</m> дээр <m>[1, 3]</m> үед
        Роллын теоремын <m>c</m>-ийг ол.</p>
      </statement>
      <solution>
        <p><m>f(1) = f(3) = 0</m>. <m>f'(x) = 2x - 4 = 0</m>
        тэгшитгэлээс <m>c = 2</m>.</p>
      </solution>
    </example>

    <theorem xml:id="thm-lagrange-mvt">
      <title>Лагранжийн дундаж утгын теорем (ДУТ)</title>
      <statement>
        <p><m>f</m> нь <m>[a,b]</m> дээр тасралтгүй, <m>(a,b)</m>
        дээр дифференциалчлагдах бол</p>
        <me>f'(c) = \frac{f(b) - f(a)}{b - a}</me>
        <p>байх <m>c \in (a,b)</m> олдоно.</p>
      </statement>
      <proof>
        <p><m>g(x) = f(x) - \dfrac{f(b)-f(a)}{b-a}(x-a)</m> гэж тодорхойловол
        <m>g(a) = g(b)</m>. Роллын теоремоор <m>g'(c) = 0</m>,
        өөрөөр хэлбэл
        <m>f'(c) = \dfrac{f(b)-f(a)}{b-a}</m>.</p>
      </proof>
    </theorem>

    <example xml:id="ex-lagrange-mvt">
      <statement>
        <p>Дараах функцүүдийн хувьд ДУТ-ийн <m>c</m>-ийг ол:
          <ol>
            <li><p><m>f(x) = x^2</m>, <m>[1, 3]</m></p></li>
            <li><p><m>f(x) = \ln x</m>, <m>[1, e]</m></p></li>
          </ol>
        </p>
      </statement>
      <solution>
        <p>а. <m>\dfrac{9-1}{3-1} = 4</m>, <m>f'(x) = 2x</m> тул
        <m>c = 2</m>.</p>
        <p>б. <m>\dfrac{1-0}{e-1}</m>, <m>f'(x) = 1/x</m> тул
        <m>c = e - 1</m>.</p>
      </solution>
    </example>

    <theorem xml:id="thm-cauchy-mvt">
      <title>Кошийн дундаж утгын теорем</title>
      <statement>
        <p><m>f, g</m> нь <m>[a,b]</m> дээр тасралтгүй, <m>(a,b)</m>
        дээр дифференциалчлагдах бол</p>
        <me>\frac{f'(c)}{g'(c)} = \frac{f(b) - f(a)}{g(b) - g(a)}</me>
        <p>байх <m>c \in (a,b)</m> олдоно.</p>
      </statement>
    </theorem>

    <subsection xml:id="subsec-lhopital">
      <title>Лопиталын дүрэм</title>

      <theorem xml:id="thm-lhopital">
        <title>Лопиталын дүрэм</title>
        <statement>
          <p><m>f, g</m> нь <m>a</m> цэгийн орчинд дифференциалчлагдаж,
          <m>g'(x) \ne 0</m>, мөн <m>x \to a</m> үед <m>f</m> ба
          <m>g</m> нь <m>0</m> эсвэл <m>\pm\infty</m> руу ойртоно гэж
          үзье. Хэрэв</p>
          <me>\lim_{x \to a} \frac{f'(x)}{g'(x)} = L</me>
          <p>оршвол <m>\lim_{x \to a} \dfrac{f(x)}{g(x)} = L</m>.</p>
        </statement>
      </theorem>

      <example xml:id="ex-lhopital">
        <statement>
          <p>Лопиталын дүрэм хэрэглэн хязгаарыг ол:
            <ol>
              <li><p><m>\displaystyle\lim_{x \to 0} \frac{\sin x}{x}</m></p></li>
              <li><p><m>\displaystyle\lim_{x \to \infty} \frac{\ln x}{x}</m></p></li>
              <li><p><m>\displaystyle\lim_{x \to 0} \frac{e^x - 1 - x}{x^2}</m></p></li>
              <li><p><m>\displaystyle\lim_{x \to 0} \frac{x - \arctan x}{x^3}</m></p></li>
            </ol>
          </p>
        </statement>
        <solution>
          <p>а. <m>\lim\dfrac{\cos x}{1} = 1</m>.</p>
          <p>б. <m>\lim\dfrac{1/x}{1} = 0</m>.</p>
          <p>в. <m>\lim\dfrac{e^x - 1}{2x} = \lim\dfrac{e^x}{2} = \dfrac{1}{2}</m>.</p>
          <p>г. <m>\lim\dfrac{1 - 1/(1+x^2)}{3x^2} = \lim\dfrac{x^2/(1+x^2)}{3x^2}
          = \dfrac{1}{3}</m>.</p>
        </solution>
      </example>
    </subsection>

    <exercises xml:id="exercises-mvt">
      <title>§4.10 Дасгалууд</title>

      <exercise xml:id="ex-mvt-1">
        <statement>
          <p>Лагранжийн ДУТ-ийн <m>c</m>-ийг ол:
            <ol>
              <li><p><m>f(x) = \sin x</m>, <m>[0, \pi]</m></p></li>
              <li><p><m>f(x) = x^3</m>, <m>[-1, 1]</m></p></li>
            </ol>
          </p>
        </statement>
        <answer>
          <p>а. <m>c = \pi/2</m>;
          б. <m>c = \pm 1/\sqrt{3}</m>.</p>
        </answer>
      </exercise>

      <exercise xml:id="ex-lhopital-1">
        <statement>
          <p>Лопиталын дүрэм хэрэглэн хязгаарыг ол:
            <ol>
              <li><p><m>\displaystyle\lim_{x \to 0} \frac{e^{ax} - \cos(\alpha x)}{e^{\beta x} - \cos(\beta x)}</m></p></li>
              <li><p><m>\displaystyle\lim_{x \to \infty} x\sin\dfrac{a}{x}</m></p></li>
              <li><p><m>\displaystyle\lim_{x \to 0} x^{\sin x}</m></p></li>
            </ol>
          </p>
        </statement>
        <answer>
          <p>а. <m>\dfrac{a^2 + \alpha^2}{\beta^2 + \beta^2}</m>;
          б. <m>a</m>;
          в. <m>1</m>.</p>
        </answer>
      </exercise>
    </exercises>
  </section>

  <!-- ============================================================
       §4.11 Өсөлт, бууралт, монотон шинжилгээ
       ============================================================ -->
  <section xml:id="sec-monotonicity">
    <title>Өсөлт, бууралт, монотон шинжилгээ</title>

    <theorem xml:id="thm-increasing-decreasing">
      <title>Өсөлт–бууралтын шалгуур</title>
      <statement>
        <p><m>f</m> функц <m>(a,b)</m> дээр дифференциалчлагддаг байг.
          <ul>
            <li><p><m>f'(x) \gt 0</m> бүх <m>x \in (a,b)</m>-д
            бол <m>f</m> нь <m>(a,b)</m>-д <term>өсөх функц</term>.</p></li>
            <li><p><m>f'(x) \lt 0</m> бүх <m>x \in (a,b)</m>-д
            бол <m>f</m> нь <m>(a,b)</m>-д <term>буурах функц</term>.</p></li>
            <li><p><m>f'(x) = 0</m> бол <m>f</m> тогтмол.</p></li>
          </ul>
        </p>
      </statement>
      <proof>
        <p>Лагранжийн ДУТ-ийг ашиглая. <m>x_1 \lt x_2 \in (a,b)</m>
        авбал <m>c \in (x_1, x_2)</m> оршиж
        <m>f(x_2) - f(x_1) = f'(c)(x_2 - x_1)</m>. <m>f'(c) \gt 0</m>
        ба <m>x_2 - x_1 \gt 0</m> тул <m>f(x_2) \gt f(x_1)</m>,
        өөрөөр хэлбэл <m>f</m> өсдөг.</p>
      </proof>
    </theorem>

    <example xml:id="ex-monotone-1">
      <statement>
        <p><m>f(x) = x^3 - 3x</m> функцийн өсөлт, бууралтын завсруудыг
        ол.</p>
      </statement>
      <solution>
        <p><m>f'(x) = 3x^2 - 3 = 3(x-1)(x+1)</m>. Тэмдгийн хүснэгт:</p>
        <tabular halign="center">
          <row header="yes" bottom="minor">
            <cell>Завсар</cell>
            <cell><m>f'(x)</m></cell>
            <cell>Монотон</cell>
          </row>
          <row><cell><m>(-\infty, -1)</m></cell>
            <cell><m>+</m></cell><cell>өсөх</cell></row>
          <row><cell><m>(-1, 1)</m></cell>
            <cell><m>-</m></cell><cell>буурах</cell></row>
          <row><cell><m>(1, +\infty)</m></cell>
            <cell><m>+</m></cell><cell>өсөх</cell></row>
        </tabular>
      </solution>
    </example>

    <example xml:id="ex-monotone-2">
      <statement>
        <p><m>f(x) = x e^{-x}</m> функцийн монотон шинжилгээ хий.</p>
      </statement>
      <solution>
        <p><m>f'(x) = e^{-x}(1 - x)</m>. <m>e^{-x} \gt 0</m> тул
        <m>f'(x)</m>-ийн тэмдэг <m>1-x</m>-ийн тэмдгээр тодорхойлогдоно.
        <m>x \lt 1</m>: өсөх; <m>x \gt 1</m>: буурах.
        Тиймээс <m>x = 1</m> — локал максимум, <m>f(1) = e^{-1}</m>.</p>
      </solution>
    </example>

    <!-- AI Лекц 8 -->
    <section xml:id="sec-ai-practice-l8">
      <title>AI-тай дасгал хийх (Лекц 8)</title>
      <introduction>
        <p>Лекц 8-ийн сэдвүүдээр Claude AI-тай дасгал хий.</p>
      </introduction>
      <interactive xml:id="ai-practice-l8"
        iframe="ai-practice.html?topics=Ролл Лагранж Кошии теорем,Лопиталын дүрэм,өсөлт бууралт,монотон шинжилгээ&amp;label=Лекц 8-ийн сэдвүүд"
        width="100%" aspect="4:3" />
    </section>
  </section>

  <!-- ════════════════════════════════════════════════════════════
       ЛЕКЦ 9
       §4.12 Локал ба глобал экстремум
       §4.13 Хотгор, гүдгэр, нугаралтын цэг
       §4.14 Функц шинжлэх, график байгуулах
       ════════════════════════════════════════════════════════════ -->

  <!-- ============================================================
       §4.12 Локал ба глобал экстремум
       ============================================================ -->
  <section xml:id="sec-extrema">
    <title>Локал ба глобал экстремум</title>

    <definition xml:id="def-local-extrema">
      <title>Локал экстремум</title>
      <statement>
        <p><m>f</m> функц <m>x = a</m> цэгийн орчинд тодорхойлогдсон
        байг. Хэрэв <m>\forall x \in (a-\delta, a+\delta)</m>-д
        <m>f(x) \le f(a)</m> (<m>f(x) \ge f(a)</m>) байхаар
        <m>\delta \gt 0</m> олддог бол <m>f(a)</m>-г
        <term>локал максимум</term> (<term>локал минимум</term>)
        гэнэ.</p>
      </statement>
    </definition>

    <definition xml:id="def-global-extrema">
      <title>Глобал экстремум</title>
      <statement>
        <p><m>f</m> нь <m>X</m> мужид тодорхойлогдсон байг.
        <m>\forall x \in X</m>-д <m>f(x) \le f(a)</m>
        (<m>f(x) \ge f(a)</m>) байвал <m>f(a)</m>-г
        <term>глобал максимум</term> (<term>глобал минимум</term>)
        гэнэ.</p>
      </statement>
    </definition>

    <theorem xml:id="thm-first-derivative-test">
      <title>I уламжлалын шалгуур (тэмдэгийн тест)</title>
      <statement>
        <p><m>x = c</m> — сэжигтэй цэг байг.
          <ul>
            <li><p><m>f'</m> нь <m>c</m> дайрах үед
            <m>+ \to -</m> солигдвол — локал максимум.</p></li>
            <li><p><m>f'</m> нь <m>c</m> дайрах үед
            <m>- \to +</m> солигдвол — локал минимум.</p></li>
            <li><p>Тэмдэг өөрчлөгдөхгүй бол — экстремум биш.</p></li>
          </ul>
        </p>
      </statement>
    </theorem>

    <theorem xml:id="thm-second-derivative-test">
      <title>II уламжлалын шалгуур</title>
      <statement>
        <p><m>f'(c) = 0</m> ба <m>f''(c)</m> оршин байг.
          <ul>
            <li><p><m>f''(c) \gt 0</m> бол — локал минимум.</p></li>
            <li><p><m>f''(c) \lt 0</m> бол — локал максимум.</p></li>
            <li><p><m>f''(c) = 0</m> бол — дүгнэлт гарахгүй.</p></li>
          </ul>
        </p>
      </statement>
    </theorem>

    <example xml:id="ex-extrema-full">
      <statement>
        <p><m>f(x) = x^4 - 4x^2</m>-ийн бүх экстремумыг ол.</p>
      </statement>
      <solution>
        <p><m>f'(x) = 4x^3 - 8x = 4x(x-\sqrt{2})(x+\sqrt{2})</m>.
        Сэжигтэй цэгүүд: <m>x = 0, \pm\sqrt{2}</m>.</p>
        <p><m>f''(x) = 12x^2 - 8</m>.</p>
        <tabular halign="center">
          <row header="yes" bottom="minor">
            <cell>Цэг</cell>
            <cell><m>f''</m></cell>
            <cell>Төрөл</cell>
            <cell>Утга</cell>
          </row>
          <row><cell><m>x = 0</m></cell>
            <cell><m>-8 \lt 0</m></cell>
            <cell>локал макс</cell>
            <cell><m>f(0) = 0</m></cell></row>
          <row><cell><m>x = \pm\sqrt{2}</m></cell>
            <cell><m>16 \gt 0</m></cell>
            <cell>локал мин</cell>
            <cell><m>f(\pm\sqrt{2}) = -4</m></cell></row>
        </tabular>
      </solution>
    </example>

    <example xml:id="ex-global-extrema">
      <title>Хаалттай завсарт глобал экстремум олох</title>
      <statement>
        <p><m>f(x) = x^3 - 3x</m>-ийн глобал экстремумыг
        <m>[-2, 2]</m> дээр ол.</p>
      </statement>
      <solution>
        <p>Сэжигтэй цэгүүд: <m>x = \pm 1</m>. Утгуудыг харьцуулъя:</p>
        <tabular halign="center">
          <row header="yes" bottom="minor">
            <cell>Цэг</cell>
            <cell>Утга</cell>
          </row>
          <row><cell><m>x = -2</m></cell>
            <cell><m>f(-2) = -2</m></cell></row>
          <row><cell><m>x = -1</m></cell>
            <cell><m>f(-1) = 2</m></cell></row>
          <row><cell><m>x = 1</m></cell>
            <cell><m>f(1) = -2</m></cell></row>
          <row><cell><m>x = 2</m></cell>
            <cell><m>f(2) = 2</m></cell></row>
        </tabular>
        <p>Глобал максимум: <m>2</m> (<m>x = -1</m> ба <m>x = 2</m>-д).
        Глобал минимум: <m>-2</m> (<m>x = -2</m> ба <m>x = 1</m>-д).</p>
      </solution>
    </example>
  </section>

  <!-- ============================================================
       §4.13 Хотгор, гүдгэр, нугаралтын цэг
       ============================================================ -->
  <section xml:id="sec-concavity">
    <title>Хотгор, гүдгэр, нугаралтын цэг</title>

    <definition xml:id="def-concavity">
      <statement>
        <p><m>f</m> функц <m>I</m> завсарт
        <term>хотгор</term> (<em>concave up</em>) байна гэдэг нь
        бүх <m>x_1, x_2 \in I</m>, <m>\lambda \in [0,1]</m>-д
        <m>f(\lambda x_1 + (1-\lambda)x_2) \le \lambda f(x_1) +
        (1-\lambda)f(x_2)</m> байхыг хэлнэ.</p>
        <p><term>Гүдгэр</term> (<em>concave down</em>) тохиолдолд
        тэнцэтгэл биш эсрэгээрээ байна.</p>
      </statement>
    </definition>

    <theorem xml:id="thm-concavity-test">
      <statement>
        <p><m>f''</m> оршин байг.
          <ul>
            <li><p><m>f''(x) \gt 0</m> бол — хотгор.</p></li>
            <li><p><m>f''(x) \lt 0</m> бол — гүдгэр.</p></li>
          </ul>
        </p>
      </statement>
    </theorem>

    <definition xml:id="def-inflection-point">
      <title>Нугаралтын цэг</title>
      <statement>
        <p><m>f</m> функц <m>x = c</m>-ийн хоёр талд хотгор/гүдгэр
        чанараа солих цэгийг <term>нугаралтын цэг</term> гэнэ.</p>
      </statement>
    </definition>

    <example xml:id="ex-concavity-1">
      <statement>
        <p><m>f(x) = x^3</m>-ийн хотгор/гүдгэр завсар, нугаралтын
        цэгийг ол.</p>
      </statement>
      <solution>
        <p><m>f''(x) = 6x</m>. <m>x \lt 0</m>: гүдгэр;
        <m>x \gt 0</m>: хотгор. <m>x = 0</m> — нугаралтын цэг.</p>
      </solution>
    </example>
  </section>

  <!-- ============================================================
       §4.14 Функц шинжлэх, график байгуулах
       ============================================================ -->
  <section xml:id="sec-curve-sketching">
    <title>Функц шинжлэх, график байгуулах</title>

    <p>Уламжлал ашиглан функцийн графикийг нарийвчлан зурах дараах
    4 алхамтай арга байна.</p>

    <p><alert>Алхам 1. Ерөнхий шинжилгээ</alert>
      <ul>
        <li>Тодорхойлогдох муж</li>
        <li>Тэгш/сондгой, үет чанар</li>
        <li>Тэнхлэгтэй огтлолцох цэгүүд</li>
        <li>Асимптотууд: хэвтээ, босоо, ташуу</li>
      </ul>
    </p>

    <p><alert>Алхам 2. I уламжлал — өсөлт/бууралт, экстремум</alert>
      <ul>
        <li>Сэжигтэй цэгүүдийг ол (<m>f' = 0</m> эсвэл <m>f'</m>
        оршихгүй)</li>
        <li>Тэмдгийн хүснэгт байгуул</li>
        <li>Локал экстремумыг тодорхойл</li>
      </ul>
    </p>

    <p><alert>Алхам 3. II уламжлал — хотгор/гүдгэр, нугаралтын цэг</alert>
      <ul>
        <li><m>f'' = 0</m> цэгүүдийг ол</li>
        <li>Хотгор/гүдгэр завсрыг тогтоо</li>
        <li>Нугаралтын цэгүүдийг тэмдэглэ</li>
      </ul>
    </p>

    <p><alert>Алхам 4. Нэгтгэж график зур</alert>
      <ul>
        <li>Чухал цэгүүдийн координатыг тооцоол</li>
        <li>Бүх мэдээллийг нэгтгэн хүснэгт бүрдүүл</li>
        <li>График зур</li>
      </ul>
    </p>

    <example xml:id="ex-sketch-full">
      <title><m>f(x) = (x+1)e^x</m> функцийн бүрэн шинжилгээ</title>
      <statement>
        <p><m>f(x) = (x+1)e^x</m> функцийг шинжлэн графикийг байгуул.</p>
      </statement>
      <solution>
        <p><alert>1. Ерөнхий шинжилгээ.</alert>
        Тодорхойлогдох муж: <m>\mathbb{R}</m>.
        <m>f(0) = 1</m> (y-тэнхлэгтэй огтлол).
        <m>f(-1) = 0</m> (x-тэнхлэгтэй огтлол).
        <m>\lim_{x \to -\infty} (x+1)e^x = 0</m> (хэвтээ асимптот
        <m>y = 0</m>).</p>

        <p><alert>2. I уламжлал.</alert>
        <m>f'(x) = e^x + (x+1)e^x = e^x(x+2)</m>.
        Сэжигтэй цэг: <m>x = -2</m>.
        <m>x \lt -2</m>: буурах; <m>x \gt -2</m>: өсөх.
        Локал минимум: <m>f(-2) = -e^{-2}</m>.</p>

        <p><alert>3. II уламжлал.</alert>
        <m>f''(x) = e^x(x+3)</m>.
        Нугаралтын цэг: <m>x = -3</m>.
        <m>x \lt -3</m>: гүдгэр; <m>x \gt -3</m>: хотгор.</p>
      </solution>
    </example>

    <example xml:id="ex-sketch-rational">
      <title>Рационал функцийн график</title>
      <statement>
        <p><m>f(x) = \dfrac{x}{x^2 + 1}</m> функцийг шинжил.</p>
      </statement>
      <solution>
        <p><alert>1.</alert> Тодорхойлогдох муж: <m>\mathbb{R}</m>.
        Сондгой функц. Хэвтээ асимптот: <m>y = 0</m>.</p>

        <p><alert>2.</alert>
        <m>f'(x) = \dfrac{(x^2+1) - x \cdot 2x}{(x^2+1)^2}
        = \dfrac{1-x^2}{(x^2+1)^2}</m>.
        Сэжигтэй: <m>x = \pm 1</m>.
        Локал максимум <m>f(1) = \frac{1}{2}</m>,
        локал минимум <m>f(-1) = -\frac{1}{2}</m>.</p>

        <p><alert>3.</alert>
        <m>f''(x) = \dfrac{2x(x^2-3)}{(x^2+1)^3}</m>.
        Нугаралтын цэгүүд: <m>x = 0, \pm\sqrt{3}</m>.</p>
      </solution>
    </example>

    <!-- AI Лекц 9 -->
    <section xml:id="sec-ai-practice-l9">
      <title>AI-тай дасгал хийх (Лекц 9)</title>
      <introduction>
        <p>Лекц 9-ийн сэдвүүдээр Claude AI-тай дасгал хий.</p>
      </introduction>
      <interactive xml:id="ai-practice-l9"
        iframe="ai-practice.html?topics=локал глобал экстремум,хотгор гүдгэр,нугаралтын цэг,функц шинжлэх,график байгуулах&amp;label=Лекц 9-ийн сэдвүүд"
        width="100%" aspect="4:3" />
    </section>
  </section>

  <!-- ============================================================
       Семинар 6 — Уламжлал I (Лекц 6-7)
       ============================================================ -->
  <section xml:id="sec-seminar-6">
    <title>Семинар 6</title>
    <exercises xml:id="exercises-seminar-6">
      <introduction>
        <p>Хамрах сэдэв: уламжлалын дүрмүүд, гинжин дүрэм, параметр,
        далд функц, дифференциал, шүргэгч.</p>
      </introduction>

      <exercise xml:id="sem6-1">
        <statement>
          <p>Дараах функцүүдийн заагдсан эрэмбийн уламжлалыг ол:
            <ol>
              <li><p><m>y = x^2 - 3x + 2</m>, <m>y'' = ?</m></p></li>
              <li><p><m>y = 1 - x^2 - x^4</m>, <m>y''' = ?</m></p></li>
              <li><p><m>y = (1+x)^6</m>, <m>y'''(2) = ?</m></p></li>
              <li><p><m>y = \cos^2 x</m>, <m>y''' = ?</m></p></li>
              <li><p><m>y = \dfrac{1}{1-x}</m>, <m>y^{(5)} = ?</m></p></li>
              <li><p><m>y = xe^{x^2}</m>, <m>y'' = ?</m></p></li>
              <li><p><m>y = \ln(x + \sqrt{1+x^2})</m>, <m>y'' = ?</m></p></li>
            </ol>
          </p>
        </statement>
      </exercise>

      <exercise xml:id="sem6-2">
        <statement>
          <p>Дараах функцүүдийн <m>n</m>-р эрэмбийн уламжлалыг ол:
            <ol>
              <li><p><m>y = e^{ax}</m></p></li>
              <li><p><m>y = \sin^2 x</m></p></li>
              <li><p><m>y = xe^x</m></p></li>
              <li><p><m>y = (x^2 + x - 1)\cos x</m></p></li>
              <li><p><m>y = e^x \cos x</m></p></li>
            </ol>
          </p>
        </statement>
      </exercise>

      <exercise xml:id="sem6-3">
        <statement>
          <p>Далд функцийн уламжлалыг ол:
            <ol>
              <li><p><m>\dfrac{x^2}{a^2} + \dfrac{y^2}{b^2} - 1 = 0</m>,
              <m>\dfrac{d^2y}{dx^2}</m></p></li>
              <li><p><m>y^3 + x^3 - 3axy = 0</m>, <m>y''</m></p></li>
              <li><p><m>e^{x+y} - xy = 0</m>, <m>y''</m></p></li>
            </ol>
          </p>
        </statement>
      </exercise>

      <exercise xml:id="sem6-4">
        <statement>
          <p>Параметр функцийн уламжлалыг ол:
            <ol>
              <li><p><m>x = at^2</m>, <m>y = bt^3</m>:
              <m>\dfrac{d^2y}{dx^2}</m></p></li>
              <li><p><m>x = a\cos t</m>, <m>y = b\sin t</m>:
              <m>\dfrac{d^3y}{dx^3}</m></p></li>
              <li><p><m>x = t - \sin t</m>, <m>y = 1 - \cos t</m>:
              <m>\dfrac{d^2y}{dx^2}</m></p></li>
            </ol>
          </p>
        </statement>
      </exercise>

      <exercise xml:id="sem6-5">
        <statement>
          <p>Дифференциал ашиглан ойролцоогоор бод:
            <ol>
              <li><p><m>\sin(0{,}12)</m></p></li>
              <li><p><m>(1{,}02)^5</m></p></li>
            </ol>
          </p>
        </statement>
      </exercise>

      <exercise xml:id="sem6-6">
        <statement>
          <p>Шүргэгч ба нормал шулуунийг ол:
            <ol>
              <li><p><m>y = \sin x + \cos x</m>, <m>x = \dfrac{\pi}{3}</m> дээр</p></li>
              <li><p><m>y = x^2 - 3x + 2</m>, <m>x = 1</m> дээр</p></li>
              <li><p><m>x = \cos t</m>, <m>y = \sin t</m>,
              <m>t = \dfrac{\pi}{4}</m> дээр</p></li>
            </ol>
          </p>
        </statement>
      </exercise>
    </exercises>
  </section>

  <!-- ============================================================
       Гэрийн даалгавар 6
       ============================================================ -->
  <section xml:id="sec-homework-6">
    <title>Гэрийн даалгавар 6</title>
    <exercises xml:id="exercises-homework-6">
      <introduction>
        <p>Бодолтыг бүрэн үндэслэлтэй бичиж ирнэ.</p>
      </introduction>

      <exercise xml:id="hw6-1">
        <statement>
          <p>Функцийн локал экстремумыг ол:
            <ol>
              <li><p><m>y = x^3 - 6x^2 + 9x - 4</m></p></li>
              <li><p><m>y = 2x^3 - x^4</m></p></li>
              <li><p><m>y = x + \dfrac{1}{x}</m></p></li>
              <li><p><m>y = \dfrac{2x}{1+x^2}</m></p></li>
              <li><p><m>y = xe^{-x}</m></p></li>
              <li><p><m>y = \cos x + \dfrac{1}{2}\cos 2x</m></p></li>
            </ol>
          </p>
        </statement>
      </exercise>

      <exercise xml:id="hw6-2">
        <statement>
          <p>Өгөгдсөн завсар дээрх хамгийн их ба хамгийн бага утгыг ол:
            <ol>
              <li><p><m>f(x) = x^2 - 4x + 6</m>, <m>[-3, 10]</m></p></li>
              <li><p><m>f(x) = x + \dfrac{1}{x}</m>, <m>[0{,}01;\, 100]</m></p></li>
              <li><p><m>f(x) = \sqrt{5 - 4x}</m>, <m>[-1, 1]</m></p></li>
            </ol>
          </p>
        </statement>
      </exercise>

      <exercise xml:id="hw6-3">
        <statement>
          <p>Лопиталын дүрэм хэрэглэн хязгаарыг ол:
            <ol>
              <li><p><m>\displaystyle\lim_{x \to 0} \frac{e^{ax} - \cos(\alpha x)}{e^{\beta x} - \cos(\beta x)}</m></p></li>
              <li><p><m>\displaystyle\lim_{x \to a} \frac{x^m - a^m}{x^n - a^n}</m></p></li>
              <li><p><m>\displaystyle\lim_{x \to \infty} x^n e^{-x}</m></p></li>
              <li><p><m>\displaystyle\lim_{x \to 0} x^{\sin x}</m></p></li>
            </ol>
          </p>
        </statement>
      </exercise>

      <exercise xml:id="hw6-4">
        <statement>
          <p><m>y = ax^2 + bx + c</m> параболын <m>x = p</m> ба
          <m>x = q</m> цэгүүд дээрх шүргэгч шулуунууд
          <m>x = \dfrac{p+q}{2}</m> цэгт огтолцохыг батал.</p>
        </statement>
      </exercise>

      <exercise xml:id="hw6-5">
        <statement>
          <p>Дараах функцүүдийг судалж, графикийг байгуул:
            <ol>
              <li><p><m>y = \dfrac{x}{1+x^2}</m></p></li>
              <li><p><m>y = \dfrac{1}{1-x^2}</m></p></li>
              <li><p><m>y = -\dfrac{x}{x^2-1}</m></p></li>
            </ol>
          </p>
        </statement>
      </exercise>
    </exercises>
  </section>

  <!-- ============================================================
       Семинар 7 — Уламжлал II (Лекц 8-9)
       ============================================================ -->
  <section xml:id="sec-seminar-7-deriv">
    <title>Семинар 7</title>
    <exercises xml:id="exercises-seminar-7-deriv">
      <introduction>
        <p>Хамрах сэдэв: дундаж утгын теорем, Лопитал, өсөлт/бууралт,
        хотгор/гүдгэр, экстремум, функц шинжлэх.</p>
      </introduction>

      <exercise xml:id="sem7-d-1">
        <statement>
          <p>Лопиталын дүрэм хэрэглэн хязгаарыг ол:
            <ol>
              <li><p><m>\displaystyle\lim_{x \to 0} \frac{e^x - 1}{\sin x}</m></p></li>
              <li><p><m>\displaystyle\lim_{x \to 0} \frac{x - \arctan x}{x^3}</m></p></li>
              <li><p><m>\displaystyle\lim_{x \to 0} \frac{x - \sin x}{x - \operatorname{tg} x}</m></p></li>
              <li><p><m>\displaystyle\lim_{x \to 1} \left[\frac{x}{x-1} - \frac{1}{\ln x}\right]</m></p></li>
              <li><p><m>\displaystyle\lim_{x \to 0} x^{\sin x}</m></p></li>
            </ol>
          </p>
        </statement>
        <answer>
          <p>а. <m>1</m>; б. <m>\frac{1}{3}</m>;
          в. <m>\frac{1}{2}</m>; г. <m>\frac{1}{2}</m>;
          д. <m>1</m>.</p>
        </answer>
      </exercise>

      <exercise xml:id="sem7-d-2">
        <statement>
          <p>Дараах функцүүдийн нугаралтын цэгүүдийг олж,
          хотгор ба гүдгэр завсрыг тодорхойл:
            <ol>
              <li><p><m>y = x^3 - 5x^2 + 3x - 5</m></p></li>
              <li><p><m>y = \ln(1+x^2)</m></p></li>
              <li><p><m>y = x + 36x^2 - 2x^3 - x^4</m></p></li>
            </ol>
          </p>
        </statement>
      </exercise>

      <exercise xml:id="sem7-d-3">
        <statement>
          <p>II уламжлал ашиглан экстремумыг тодорхойл:
            <ol>
              <li><p><m>y = x^3 - 2ax^2 + a^2 x</m> (<m>a \gt 0</m>)</p></li>
              <li><p><m>y = x^2(a-x)^2</m></p></li>
              <li><p><m>y = x + \sqrt{1-x}</m></p></li>
            </ol>
          </p>
        </statement>
      </exercise>

      <exercise xml:id="sem7-d-4">
        <statement>
          <p>Өсөх, буурах завсрыг ол:
            <ol>
              <li><p><m>y = (x-2)^5(2x+1)^4</m></p></li>
              <li><p><m>y = x - e^x</m></p></li>
              <li><p><m>y = \dfrac{1-x+x^2}{1+x+x^2}</m></p></li>
              <li><p><m>y = x^2 - \ln x</m></p></li>
            </ol>
          </p>
        </statement>
      </exercise>

      <exercise xml:id="sem7-d-5">
        <statement>
          <p>Дараах функцүүдийг судалж, графикийг байгуул:
            <ol>
              <li><p><m>y = \dfrac{x}{1+x^2}</m></p></li>
              <li><p><m>y = \dfrac{1}{1-x^2}</m></p></li>
            </ol>
          </p>
        </statement>
      </exercise>

      <exercise xml:id="sem7-d-6">
        <statement>
          <p>Функц зохион хамгийн их/бага утга ол:
            <ol>
              <li><p>8 тоог хоёр хэсэгт задлахад кубуудын нийлбэр
              хамгийн бага байхаар задла.</p></li>
              <li><p>Эзэлхүүн нь <m>72\,\text{см}^3</m>, суурийн
              талуудын харьцаа <m>1:2</m> байх тагтай хайрцагны
              гадаргуугийн хамгийн бага талбайг ол.</p></li>
              <li><p><m>18 \times 18</m> квадрат цаасны булангаас
              тэнцүү квадрат хайчлан хамгийн их багтаамжтай хайрцаг
              хийхэд хайчлах квадратын талыг ол.</p></li>
            </ol>
          </p>
        </statement>
      </exercise>
    </exercises>
  </section>

  <!-- ============================================================
       Гэрийн даалгавар 7
       ============================================================ -->
  <section xml:id="sec-homework-7-deriv">
    <title>Гэрийн даалгавар 7</title>
    <exercises xml:id="exercises-homework-7-deriv">
      <introduction>
        <p>Бодолтыг бүрэн үндэслэлтэй бичиж ирнэ.</p>
      </introduction>

      <exercise xml:id="hw7-d-1">
        <statement>
          <p>Лопиталын дүрэм хэрэглэн хязгаарыг ол:
            <ol>
              <li><p><m>\displaystyle\lim_{x \to 0} \frac{a^x - b^x}{c^x - d^x}</m></p></li>
              <li><p><m>\displaystyle\lim_{x \to 0} \frac{e^x - e^{-x}}{\sin x \cos x}</m></p></li>
              <li><p><m>\displaystyle\lim_{x \to +\infty} x^n e^{-x}</m></p></li>
              <li><p><m>\displaystyle\lim_{x \to 0} \left(\cot x - \frac{1}{x}\right)</m></p></li>
              <li><p><m>\displaystyle\lim_{x \to \infty}(e^x + e^{-x})^{1/x}</m></p></li>
            </ol>
          </p>
        </statement>
      </exercise>

      <exercise xml:id="hw7-d-2">
        <statement>
          <p>Дараах функцүүдийн локал экстремум, нугаралтын цэг,
          хотгор/гүдгэр завсрыг тодорхойл:
            <ol>
              <li><p><m>y = 3x^5 - 5x^4 + 3x - 2</m></p></li>
              <li><p><m>y = -\dfrac{x^3}{x^2+3a^2}</m> (<m>a \gt 0</m>)</p></li>
              <li><p><m>y = e^{\sin x}</m>, <m>-\dfrac{\pi}{2} \le x \le \dfrac{\pi}{2}</m></p></li>
              <li><p><m>y = x^2 e^{-x}</m></p></li>
              <li><p><m>y = x^{1/x}</m></p></li>
            </ol>
          </p>
        </statement>
      </exercise>

      <exercise xml:id="hw7-d-3">
        <statement>
          <p>Функц зохион хамгийн их/бага утга ол:
            <ol>
              <li><p>Үүсгэгч урт <m>20\,\text{см}</m> байх конус
              хэлбэрийн воронка хийх. Эзэлхүүн хамгийн их байх
              өндрийг ол.</p></li>
              <li><p>Периметр нь <m>2p</m> байх тэгш өнцөгт
              гурвалжийг эргүүлэхэд үүсэх биетийн эзэлхүүн хамгийн
              их байх гурвалжны хэмжээг ол.</p></li>
            </ol>
          </p>
        </statement>
      </exercise>

      <exercise xml:id="hw7-d-4">
        <statement>
          <p>ДУТ ашиглан <m>e^x \ge 1 + x</m> бүх <m>x</m>-д
          биелэхийг батал.</p>
        </statement>
      </exercise>

      <exercise xml:id="hw7-d-5">
        <statement>
          <p><m>y = x^2</m> параболын <m>x = p</m> ба <m>x = q</m>
          цэгүүд дээрх шүргэгч шулуунууд перпендикуляр бол тэдгээрийн
          огтолцолын цэг нь <m>y = -\dfrac{1}{4}</m> шулуун дээр
          оршихыг батал.</p>
        </statement>
      </exercise>
    </exercises>
  </section>

</chapter>
