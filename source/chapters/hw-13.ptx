<!-- Гэрийн даалгавар 13. Эх сурвалж: latex/lectures/homework.tex -->
<section xml:id="sec-homework-13" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Гэрийн даалгавар 13</title>
  <exercises xml:id="exercises-homework-13">
    <introduction>
      <p>Интегралуудыг бод.</p>
    </introduction>
    <exercise xml:id="hw13-1">
      <statement>
        <p><m>\displaystyle \int \frac{dx}{2x-1}.</m></p>
      </statement>
    </exercise>
    <exercise xml:id="hw13-2">
      <statement>
        <p><m>\displaystyle \int \frac{dx}{cx+m}.</m></p>
      </statement>
    </exercise>
    <exercise xml:id="hw13-3">
      <statement>
        <p><m>\displaystyle \int \frac{x\,dx}{x^{2}+1}.</m></p>
      </statement>
    </exercise>
    <exercise xml:id="hw13-4">
      <statement>
        <p><m>\displaystyle \int \frac{x^{2}\,dx}{x^{3}+1}.</m></p>
      </statement>
    </exercise>
    <exercise xml:id="hw13-5">
      <statement>
        <p><m>\displaystyle \int \frac{e^{x} dx}{e^{x}+1}.</m></p>
      </statement>
    </exercise>
    <exercise xml:id="hw13-6">
      <statement>
        <p><m>\displaystyle \int \frac{e^{2x} dx}{e^{2x}+a^{2}}.</m></p>
      </statement>
    </exercise>
    <exercise xml:id="hw13-7">
      <statement>
        <p><m>\displaystyle \int \tan x\, dx.</m></p>
      </statement>
    </exercise>
    <exercise xml:id="hw13-8">
      <statement>
        <p><m>\displaystyle \int \cot x\, dx.</m></p>
      </statement>
    </exercise>
    <exercise xml:id="hw13-9">
      <statement>
        <p><m>\displaystyle \int \tan 3x\, dx.</m></p>
      </statement>
    </exercise>
    <exercise xml:id="hw13-10">
      <statement>
        <p><m>\displaystyle \int \cot(2x+1)\, dx.</m></p>
      </statement>
    </exercise>
    <exercise xml:id="hw13-11">
      <statement>
        <p><m>\displaystyle \int \frac{\sin 2x}{1+\cos^{2}x}\, dx.</m></p>
      </statement>
    </exercise>
    <exercise xml:id="hw13-12">
      <statement>
        <p><m>\displaystyle \int \frac{dx}{x \ln x}.</m></p>
      </statement>
    </exercise>
    <exercise xml:id="hw13-13">
      <statement>
        <p><m>\displaystyle \int \frac{(\ln x)^{m}}{x}\, dx.</m></p>
      </statement>
    </exercise>
    <exercise xml:id="hw13-14">
      <statement>
        <p><m>\displaystyle \int e^{\sin x}\, d(\sin x).</m></p>
      </statement>
    </exercise>
    <exercise xml:id="hw13-15">
      <statement>
        <p><m>\displaystyle \int e^{\sin x}\cos x\, dx.</m></p>
      </statement>
    </exercise>
    <exercise xml:id="hw13-16">
      <statement>
        <p><m>\displaystyle \int a^{3x}\, dx.</m></p>
      </statement>
    </exercise>
    <exercise xml:id="hw13-17">
      <statement>
        <p><m>\displaystyle \int a^{-x}\, dx.</m></p>
      </statement>
    </exercise>
    <exercise xml:id="hw13-18">
      <statement>
        <p><m>\displaystyle \int e^{-3x+1}\, dx.</m></p>
      </statement>
    </exercise>
    <exercise xml:id="hw13-19">
      <statement>
        <p><m>\displaystyle \int e^{x^{2}} x\, dx.</m></p>
      </statement>
    </exercise>
    <exercise xml:id="hw13-20">
      <statement>
        <p><m>\displaystyle \int e^{-x^{3}} x^{2}\, dx.</m></p>
      </statement>
    </exercise>
    <exercise xml:id="hw13-21">
      <statement>
        <p><m>\displaystyle \int \frac{d\left(\frac{x}{3}\right)}{\sqrt{1-\left(\frac{x}{3}\right)^{2}}}.</m></p>
      </statement>
    </exercise>
    <exercise xml:id="hw13-22">
      <statement>
        <p><m>\displaystyle \int \frac{dx}{\sqrt{1-25x^{2}}}.</m></p>
      </statement>
    </exercise>
    <exercise xml:id="hw13-23">
      <statement>
        <p><m>\displaystyle \int \frac{dx}{1+9x^{2}}.</m></p>
      </statement>
    </exercise>
    <exercise xml:id="hw13-24">
      <statement>
        <p><m>\displaystyle \int \frac{dx}{\sqrt{4-x^{2}}}.</m></p>
      </statement>
    </exercise>
    <exercise xml:id="hw13-25">
      <statement>
        <p><m>\displaystyle \int \frac{dx}{2x^{2}+9}.</m></p>
      </statement>
    </exercise>
    <exercise xml:id="hw13-26">
      <statement>
        <p><m>\displaystyle \int \frac{dx}{\sqrt{4-9x^{2}}}.</m></p>
      </statement>
    </exercise>
    <exercise xml:id="hw13-27">
      <statement>
        <p><m>\displaystyle \int \frac{x\, dx}{x^{4}+1}.</m></p>
      </statement>
    </exercise>
    <exercise xml:id="hw13-28">
      <statement>
        <p><m>\displaystyle \int \frac{x\, dx}{a^{2}-x^{4}}.</m></p>
      </statement>
    </exercise>
    <exercise xml:id="hw13-29">
      <statement>
        <p><m>\displaystyle \int \frac{x^{2} dx}{x^{6}+4}.</m></p>
      </statement>
    </exercise>
    <exercise xml:id="hw13-30">
      <statement>
        <p><m>\displaystyle \int \frac{x^{3} dx}{\sqrt{1-x^{8}}}.</m></p>
      </statement>
    </exercise>
    <exercise xml:id="hw13-31">
      <statement>
        <p><m>\displaystyle \int \frac{e^{x} dx}{e^{2x}+4}.</m></p>
      </statement>
    </exercise>
    <exercise xml:id="hw13-32">
      <statement>
        <p><m>\displaystyle \int \frac{2^{x} dx}{\sqrt{1-4^{x}}}.</m></p>
      </statement>
    </exercise>
    <exercise xml:id="hw13-33">
      <statement>
        <p><m>\displaystyle \int \frac{\cos\alpha\, d\alpha}{a^{2}+\sin^{2}\alpha}.</m></p>
      </statement>
    </exercise>
    <exercise xml:id="hw13-34">
      <statement>
        <p><m>\displaystyle \int \frac{e^{2x}-1}{e^{x}}\, dx.</m></p>
      </statement>
    </exercise>
    <exercise xml:id="hw13-35">
      <statement>
        <p><m>\displaystyle \int (e^{x}+1)^{3} dx.</m></p>
      </statement>
    </exercise>
    <exercise xml:id="hw13-36">
      <statement>
        <p><m>\displaystyle \int \frac{1+x}{\sqrt{1-x^{2}}}\, dx.</m></p>
      </statement>
    </exercise>
    <exercise xml:id="hw13-37">
      <statement>
        <p><m>\displaystyle \int \frac{8x-1}{x^{2}+9} dx.</m></p>
      </statement>
    </exercise>
    <exercise xml:id="hw13-38">
      <statement>
        <p><m>\displaystyle \int \frac{\sqrt{1-x}}{1+x}\, dx.</m></p>
      </statement>
    </exercise>
    <exercise xml:id="hw13-39">
      <statement>
        <p><m>\displaystyle \int \frac{x(1-x^{2})}{1+x^{4}}\, dx.</m></p>
      </statement>
    </exercise>
    <exercise xml:id="hw13-40">
      <statement>
        <p><m>\displaystyle \int \frac{1+x-x^{2}}{\sqrt{(1-x^{2})^{3}}}\, dx.</m></p>
      </statement>
    </exercise>
    <exercise xml:id="hw13-41">
      <statement>
        <p><m>\displaystyle \int \frac{dx}{(x+\sqrt{x^{2}-1})^{2}}.</m></p>
      </statement>
    </exercise>
  </exercises>
</section>
