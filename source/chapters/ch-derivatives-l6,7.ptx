      width="100%" aspect="4:3" />
  </section>

  <!-- ============================================================
       Семинар 7 — Уламжлал II (Лекц 7)
       ============================================================ -->
  <section xml:id="sec-seminar-7-deriv">
    <title>Семинар 7</title>
    <exercises xml:id="exercises-seminar-7-deriv">
      <introduction>
        <p>Хамрах сэдэв: гинжин дүрэм, параметр функц, далд ялгах,
        дээд эрэмбийн уламжлал, дифференциал.</p>
      </introduction>

      <exercise xml:id="sem7-d-1">
        <statement>
          <p>Гинжин дүрэм болон бусад дүрмүүдийг хослуулан уламжлалыг ол:
            <ol>
              <li><p><m>f(x) = e^{x^2}\sin x</m></p></li>
              <li><p><m>g(x) = \ln(\operatorname{tg} x)</m></p></li>
              <li><p><m>h(x) = \arcsin(\sqrt{x})</m></p></li>
              <li><p><m>k(x) = (x^2+1)^{\sin x}</m></p></li>
            </ol>
          </p>
        </statement>
        <answer>
          <p>а. <m>e^{x^2}(2x\sin x + \cos x)</m>;
          б. <m>\dfrac{1}{\sin x\cos x}</m>;
          в. <m>\dfrac{1}{2\sqrt{x(1-x)}}</m>;
          г. Логарифмчлан: <m>k'= k\left[\cos x\cdot\ln(x^2+1)
          + \sin x\cdot\dfrac{2x}{x^2+1}\right]</m>.</p>
        </answer>
      </exercise>

      <exercise xml:id="sem7-d-2">
        <statement>
          <p>Далд ялгах аргаар <m>y'</m>-ийг ол:
            <ol>
              <li><p><m>x^2-xy+y^2=3</m></p></li>
              <li><p><m>\sin(x+y)=y^2\cos x</m></p></li>
            </ol>
          </p>
        </statement>
        <answer>
          <p>а. <m>y' = \dfrac{2x-y}{x-2y}</m>;
          б. <m>y' = \dfrac{\cos(x+y)+y^2\sin x}{2y\cos x - \cos(x+y)}</m>.</p>
        </answer>
      </exercise>

      <exercise xml:id="sem7-d-3">
        <statement>
          <p><m>x(t) = t^2</m>, <m>y(t) = t^3 - t</m> параметр
          функцийн <m>t=1</m> дээрх шүргэгч шулуунийг ол.</p>
        </statement>
        <answer>
          <p><m>\dfrac{dy}{dx} = \dfrac{3t^2-1}{2t}</m>.
          <m>t=1</m> үед: налуу <m>=1</m>, цэг <m>(1, 0)</m>.
          Шүргэгч: <m>y = x - 1</m>.</p>
        </answer>
      </exercise>

      <exercise xml:id="sem7-d-4">
        <statement>
          <p><m>y = x^3 - x</m>-ийн <m>y''</m>-ийг ол.
          Хоёр дахь уламжлал тэгтэй тэнцүү болох цэгийг ол.</p>
        </statement>
        <answer>
          <p><m>y'' = 6x</m>; <m>y''=0</m> үед <m>x=0</m>.</p>
        </answer>
      </exercise>

      <exercise xml:id="sem7-d-5">
        <statement>
          <p>Дифференциалыг ашиглан дөхөлт ол:
            <ol>
              <li><p><m>\sin(31°)</m></p></li>
              <li><p><m>\sqrt[3]{8{,}1}</m></p></li>
            </ol>
          </p>
        </statement>
        <answer>
          <p>а. <m>\sin(31°) \approx \sin(30°) + \cos(30°)\cdot\frac{\pi}{180}
          \approx 0{,}5 + \frac{\sqrt{3}}{2}\cdot 0{,}01745 \approx 0{,}515</m>;
          б. <m>\sqrt[3]{8{,}1} \approx 2 + \frac{0{,}1}{3\cdot 4} \approx 2{,}008</m>.</p>
        </answer>
      </exercise>
    </exercises>
  </section>

  <!-- ============================================================
       Гэрийн даалгавар 7
       ============================================================ -->
  <section xml:id="sec-homework-7-deriv">
    <title>Гэрийн даалгавар 7</title>
    <exercises xml:id="exercises-homework-7-deriv">
      <introduction>
        <p>Бодолтыг бүрэн үндэслэлтэй бичиж ирнэ.</p>
      </introduction>

      <exercise xml:id="hw7-d-1">
        <statement>
          <p>Уламжлалыг ол:
            <ol>
              <li><p><m>y = (2-7x)^5</m></p></li>
              <li><p><m>y = \sqrt{5 - 4x}</m></p></li>
              <li><p><m>y = e^{\sin(x^2)}</m></p></li>
              <li><p><m>y = \ln\!\left(\operatorname{tg}\frac{x}{2}\right)</m></p></li>
            </ol>
          </p>
        </statement>
      </exercise>

      <exercise xml:id="hw7-d-2">
        <statement>
          <p>Далд ялгах аргаар <m>y'</m>-ийг олж, зааж өгсөн цэгт
          шүргэгч шулуун байгуул:
          <m>x^2y+y^3=5</m>, цэг <m>(2,1)</m>.</p>
        </statement>
      </exercise>

      <exercise xml:id="hw7-d-3">
        <statement>
          <p>Параметр функцийн <m>\dfrac{d^2y}{dx^2}</m>-ийг ол:
          <m>x = \cos t</m>, <m>y = \sin t</m>.</p>
        </statement>
        <answer>
          <p><m>\dfrac{d^2y}{dx^2} = -\dfrac{1}{\sin^3 t}</m>.</p>
        </answer>
      </exercise>

      <exercise xml:id="hw7-d-4">
        <statement>
          <p>Лейбницийн дүрэм хэрэглэн
          <m>(x^2 e^x)^{(5)}</m>-ийг ол.</p>
        </statement>
      </exercise>

      <exercise xml:id="hw7-d-5">
        <statement>
          <p><m>y = x^2</m> параболын <m>x = p</m> ба <m>x = q</m>
          цэгүүд дээрх шүргэгч шулуунууд перпендикуляр бол тэдгээрийн
          огтолцолын цэг нь <m>y = -\dfrac{1}{4}</m> шулуун дээр
          оршихыг батал.</p>
        </statement>
      </exercise>
    </exercises>
  </section>

</chapter>
